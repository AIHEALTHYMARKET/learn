rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ───────── 身分判斷 ─────────
    function signedIn() { return request.auth != null; }

    // 管理員 = 這個 Gmail 且 Google 已驗證。若要更換管理員，只需改這一行的 Email，
    // 並同步修改 app.js 最上方的 ADMIN_EMAIL。
    function isAdmin() {
      return signedIn()
        && request.auth.token.email_verified == true
        && request.auth.token.email == "diabolo.weien@gmail.com";
    }

    // 已被管理員核准的會員（users/{uid}.status == "approved"）
    function isApprovedMember() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.status == "approved";
    }
    function approved() { return isAdmin() || isApprovedMember(); }

    // 本人是否已被核准進入這個分類（categoryAccess/{分類ID}_{uid}.status == "approved"）
    function hasCategoryAccess(categoryId) {
      return signedIn()
        && exists(/databases/$(database)/documents/categoryAccess/$(categoryId + "_" + request.auth.uid))
        && get(/databases/$(database)/documents/categoryAccess/$(categoryId + "_" + request.auth.uid)).data.status == "approved";
    }

    // 這個分類目前的使用者能不能讀？
    //   公開分類（requiresApproval 不是 true，且 type 不是 nutrition）→ 所有登入者
    //   審核分類 / 營養課程                                      → 管理員，或已被核准進入該分類的人
    function canReadCategory(categoryId) {
      return exists(/databases/$(database)/documents/categories/$(categoryId))
        && (
          (get(/databases/$(database)/documents/categories/$(categoryId)).data.get('requiresApproval', false) != true
            && get(/databases/$(database)/documents/categories/$(categoryId)).data.type != "nutrition")
          || isAdmin()
          || hasCategoryAccess(categoryId)
        );
    }

    // ───────── 會員資料 ─────────
    match /users/{uid} {
      // 自己能讀自己；管理員能讀全部（會員審核頁需要）
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());

      // 首次登入只能建立「待審核」且 Email 必須與登入帳號一致；不能自己寫 approved
      allow create: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(["email", "name", "photoURL", "status", "createdAt", "lastSeen"])
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.status == "pending";

      // 管理員可核准／撤銷；一般會員只能改自己的顯示資料，不能動 status
      allow update: if isAdmin()
        || (signedIn() && request.auth.uid == uid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["name", "photoURL", "lastSeen"]));

      allow delete: if isAdmin();

      // 學習進度：只有本人能讀寫
      match /progress/{lessonId} {
        // 讀取只需要是本人（不能在 read 規則裡用 {lessonId} 去查別的文件，否則整批列表查詢會被拒絕）
        allow read: if signedIn() && request.auth.uid == uid;

        // 寫入時才檢查：該課程存在、且本人有權限讀取該課程所屬分類
        allow create, update: if signedIn() && request.auth.uid == uid
          && request.resource.data.keys().hasOnly(["percent", "completed", "position", "started", "updatedAt"])
          && exists(/databases/$(database)/documents/lessons/$(lessonId))
          && canReadCategory(get(/databases/$(database)/documents/lessons/$(lessonId)).data.categoryId);

        allow delete: if signedIn() && request.auth.uid == uid;
      }

      // 個人筆記：只有本人能讀寫；內容必須是文字且不超過 20000 字元
      match /notes/{noteId} {
        allow read, delete: if signedIn() && request.auth.uid == uid;
        allow create, update: if signedIn() && request.auth.uid == uid
          && request.resource.data.keys().hasOnly(["lessonId", "title", "categoryName", "content", "createdAt", "updatedAt"])
          && request.resource.data.content is string
          && request.resource.data.content.size() <= 20000;
      }
    }

    // ───────── 分類 ─────────
    match /categories/{categoryId} {
      // 登入者可看到分類名稱與簡介；真正的課程內容由 lessons 規則把關
      allow read: if signedIn();
      allow create, update, delete: if isAdmin();
    }

    // ───────── 分類進入申請 ─────────
    // 文件 ID 固定為「分類ID_uid」，每人每個分類只會有一筆。
    match /categoryAccess/{accessId} {
      // 本人只能（用 uid 條件）查自己的；管理員可讀全部
      allow read: if isAdmin() || (signedIn() && resource.data.uid == request.auth.uid);

      // 只能替自己建立「待審核」申請；不能自己寫 approved，也不能覆寫既有紀錄
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(["categoryId", "uid", "email", "name", "status", "requestedAt"])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.status == "pending"
        && accessId == request.resource.data.categoryId + "_" + request.auth.uid
        && exists(/databases/$(database)/documents/categories/$(request.resource.data.categoryId));

      // 核准、拒絕、撤銷都只有管理員能做
      allow update, delete: if isAdmin();
    }

    // ───────── 課程內容 ─────────
    match /lessons/{lessonId} {
      // 管理員放在最前面：管理員後台要一次列出全部課程（含沒有分類的孤兒課程），
      // 若沒有這一行，整批列表查詢會因為規則無法預先證明而被拒絕。
      allow read: if isAdmin()
        || (signedIn() && canReadCategory(resource.data.categoryId));
      allow create, update, delete: if isAdmin();
    }

    // ───────── 書本（閱讀分頁） ─────────
    match /books/{bookId} {
      // 管理員、已核准會員可讀全部；其他登入者只能讀「不需審核」的書
      // （前端對未核准會員會加上 where("requiresApproval","==",false) 查詢）
      allow read: if isAdmin()
        || (signedIn() && (approved() || resource.data.get('requiresApproval', false) != true));
      allow create, update, delete: if isAdmin();
    }

    // ───────── 網站設定（品牌 Logo） ─────────
    // Logo 要顯示在登入頁，所以未登入也要能讀；只有管理員能寫，且只能是兩張不太大的圖片字串。
    match /settings/{settingId} {
      allow read: if true;
      allow create, update: if isAdmin()
        && settingId == "branding"
        && request.resource.data.keys().hasOnly(["logo", "icon", "updatedAt"])
        && request.resource.data.logo is string && request.resource.data.logo.size() < 700000
        && request.resource.data.icon is string && request.resource.data.icon.size() < 700000;
      allow delete: if isAdmin();
    }

    // ───────── 公告 ─────────
    match /announcements/{announcementId} {
      allow read: if signedIn();
      allow create, update, delete: if isAdmin();
    }
  }
}
